{
  "name": "LunchSignal · sign-up → demand alert → benefit scan → sales",
  "nodes": [
    {
      "id": "b4637e2e-ff5a-4e24-9233-e9dadb8fd7d6",
      "name": "Lunch sign-up form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ],
      "webhookId": "107c53fb-47b7-4505-961c-b592f00a5bb0",
      "parameters": {
        "formTitle": "Want proper lunch at your office?",
        "formDescription": "Sign up with your work e-mail. When 5 colleagues from your company ask, we tell your People team how a tax-free lunch benefit of up to €7.67 per workday works. GTM Hackathon Berlin demo; data deleted after the event.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Work email",
              "fieldType": "email",
              "placeholder": "you@company.com",
              "requiredField": true
            },
            {
              "fieldLabel": "Office city",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Berlin"
                  },
                  {
                    "option": "München"
                  },
                  {
                    "option": "Düsseldorf"
                  },
                  {
                    "option": "Köln"
                  },
                  {
                    "option": "Other"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Consent",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Yes, store my e-mail to count sign-ups per company and contact me once"
                  }
                ]
              }
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "You're on the list. Thanks!"
            }
          }
        }
      }
    },
    {
      "id": "ba0267fa-6a93-4f23-90ed-f95fba3253a3",
      "name": "Normalize e-mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "const FREEMAIL = new Set([\"gmail.com\",\"googlemail.com\",\"gmx.de\",\"gmx.net\",\"web.de\",\"yahoo.com\",\"yahoo.de\",\n  \"outlook.com\",\"outlook.de\",\"hotmail.com\",\"hotmail.de\",\"live.com\",\"icloud.com\",\"me.com\",\"t-online.de\",\n  \"posteo.de\",\"mailbox.org\",\"proton.me\",\"protonmail.com\",\"aol.com\",\"freenet.de\"]);\nconst MULTI = new Set([\"co.uk\",\"com.au\",\"co.at\",\"ac.uk\"]);\nconst j = $input.first().json;\nconst key = Object.keys(j).find(k => /mail/i.test(k));\nconst email = String(j[key] ?? \"\").trim().toLowerCase();\nconst host = email.includes(\"@\") ? email.split(\"@\").pop() : \"\";\nconst labels = host.split(\".\");\nconst lastTwo = labels.slice(-2).join(\".\");\nconst reg = MULTI.has(lastTwo) && labels.length >= 3 ? labels.slice(-3).join(\".\") : lastTwo;\nconst company_domain = host && !FREEMAIL.has(reg) ? reg : null;\nreturn [{ json: { email, city: j[\"Office city\"] ?? null, company_domain, consent_at: new Date().toISOString() } }];"
      }
    },
    {
      "id": "88073f9b-c5f6-47d5-b641-a39edbdc2832",
      "name": "Save sign-up",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        440,
        300
      ],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase (set me)"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "Unique e-mail: a repeat sign-up goes to the error output and stops here.",
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "signups",
        "dataToSend": "autoMapInputData"
      }
    },
    {
      "id": "718c6f2b-4b24-4c13-b288-060e2ea70f94",
      "name": "Company e-mail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        280
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "76a1eea4-c5d6-460a-8961-2c4681241e32",
              "leftValue": "={{ $('Normalize e-mail').first().json.company_domain }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e06a9745-cfd2-4af7-a00c-62178b6d371a",
      "name": "Colleagues signed up",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        880,
        260
      ],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase (set me)"
        }
      },
      "alwaysOutputData": true,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "signups",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=company_domain=eq.{{ $('Normalize e-mail').first().json.company_domain }}&select=id"
      }
    },
    {
      "id": "9a0ddd7e-fbf1-42dd-b315-22caf1ea2878",
      "name": "Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        260
      ],
      "parameters": {
        "jsCode": "const domain = $('Normalize e-mail').first().json.company_domain;\nconst city = $('Normalize e-mail').first().json.city;\nconst signups = $input.all().length;\nreturn [{ json: { domain, city, signups, threshold: 5, reached: signups >= 5 } }];"
      }
    },
    {
      "id": "93a51c91-a93b-40cd-b43c-36e091aff749",
      "name": "5+ colleagues?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        260
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
