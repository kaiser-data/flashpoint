# Copy to .env and fill in. Never commit .env.
# n8n → Settings → n8n API → Create an API key
N8N_BASE_URL=https://YOUR-NAME.app.n8n.cloud
N8N_API_KEY=
# console.apify.com → Settings → API & Integrations → Personal API token
APIFY_TOKEN=
# featherless.ai → Account → API Keys; model id from the model catalogue
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct
# who receives briefings and hot replies
SALES_EMAIL=
# leave empty: generated automatically, shared by Apps Script and n8n
SIGNAL_SECRET=
# extra sales recipients, comma-separated (briefings, agent e-mail copies, hot replies)
SALES_TEAM=
